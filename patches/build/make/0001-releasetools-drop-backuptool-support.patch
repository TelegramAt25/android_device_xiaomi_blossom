From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: atharvnegi <atharvnegi2951@gmail.com>
Date: Tue, 25 Feb 2025 23:09:18 +0700
Subject: [PATCH] releasetools: drop backuptool support

reverts 0f5817f843b2a843c82ffd762a2eabb95bbd7121

Change-Id: Ibf7228cb8cc53b525d20ad6b250c69f419de26a6
---
 core/Makefile                               | 11 -----------
 tools/releasetools/edify_generator.py       | 20 --------------------
 tools/releasetools/non_ab_ota.py            |  7 -------
 tools/releasetools/ota_from_target_files.py |  8 --------
 4 files changed, 46 deletions(-)

diff --git a/core/Makefile b/core/Makefile
index e79ab0a..2ca4ae3 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -7164,7 +7164,6 @@ PATH=$(INTERNAL_USERIMAGES_BINARY_PATHS):$(dir $(ZIP2ZIP)):$$PATH \
     $(OTA_FROM_TARGET_FILES) \
         --verbose \
         --path $(HOST_OUT) \
-        --backup=$(backuptool) \
         $(if $(OEM_OTA_CONFIG), --oem_settings $(OEM_OTA_CONFIG)) \
         $(if $(BOOT_VAR_OTA_CONFIG), --boot_variable_file $(BOOT_VAR_OTA_CONFIG)) \
         $(2) \
@@ -7182,16 +7181,6 @@ INTERNAL_OTA_METADATA := $(PRODUCT_OUT)/ota_metadata
 
 $(call declare-0p-target,$(INTERNAL_OTA_METADATA))
 
-ifeq ($(TARGET_BUILD_VARIANT),user)
-    $(INTERNAL_OTA_PACKAGE_TARGET): backuptool := false
-else
-ifneq ($(LINEAGE_BUILD),)
-    $(INTERNAL_OTA_PACKAGE_TARGET): backuptool := true
-else
-    $(INTERNAL_OTA_PACKAGE_TARGET): backuptool := false
-endif
-endif
-
 $(INTERNAL_OTA_PACKAGE_TARGET): KEY_CERT_PAIR := $(DEFAULT_KEY_CERT_PAIR)
 $(INTERNAL_OTA_PACKAGE_TARGET): .KATI_IMPLICIT_OUTPUTS := $(INTERNAL_OTA_METADATA)
 $(INTERNAL_OTA_PACKAGE_TARGET): $(BUILT_TARGET_FILES_DIR) $(OTA_FROM_TARGET_FILES) $(INTERNAL_OTATOOLS_FILES)
